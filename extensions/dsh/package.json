{
  "name": "@fisharly/gitviz-dsh",
  "version": "0.3.0",
  "description": "Interactive Git version tree, snapshot comparison and safe restore for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "Harly",
  "repository": {
    "type": "git",
    "url": "https://github.com/fisHarly0/gitviz.git"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "host.mjs",
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
