{
  "name": "gitviz",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:bundle": "tauri build",
    "build": "vite build",
    "extension:build": "vite build --config vite.extension.config.js",
    "extension:package": "npm run extension:build && node scripts/package-extension.mjs",
    "extension:test": "node --test tests/version-tree.test.js tests/git-service.test.cjs tests/git-process.test.cjs tests/operation-host.test.cjs tests/vscode-lifecycle.test.cjs",
    "dsh:build": "vite build --config vite.dsh.config.js",
    "dsh:package": "npm run dsh:build && node scripts/package-dsh.mjs",
    "dsh:test": "node --test tests/dsh-host.test.mjs",
    "history:test": "node --test tests/large-history.test.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "package:check": "node scripts/check-packages.mjs",
    "delivery:test": "node --test tests/delivery.test.mjs",
    "artifacts:manifest": "node scripts/artifact-manifest.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gitgraph/react": "^1.6.0",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "diff": "^9.0.0",
    "jszip": "^3.10.1",
    "react": "^19.2.6",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "8.5.14",
    "vite": "^8.0.12"
  }
}
